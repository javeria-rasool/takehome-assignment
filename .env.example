# ──────────────────────────────────────────────────────────────
# AI Pipeline — Environment Variables
# Copy this file to .env and fill in all values before running.
# ──────────────────────────────────────────────────────────────

# ── Jira ──────────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# ── Anthropic (Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo-name
GITHUB_DEFAULT_BRANCH=main

# ── Vercel ────────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=          # Leave blank if personal account

# ── Email ─────────────────────────────────────────────────────
# Choose one provider: smtp | sendgrid | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=pipeline@yourdomain.com
EMAIL_TO=recipient@yourdomain.com

# SMTP (Gmail example — use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# SendGrid (only needed if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Resend (only needed if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ── Pipeline settings ─────────────────────────────────────────
WORKSPACE_DIR=/tmp/pipeline-workspace
POLL_INTERVAL_MINUTES=5
